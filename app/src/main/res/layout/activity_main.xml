<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🧾"
            android:textSize="22sp"
            android:background="@drawable/bg_spinner_field" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_print_title"
                android:textColor="#1E293B"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/receipt_preparing"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnManagePrinters"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="@string/manage_printers_card"
            app:tint="#64748B" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/target_printer_header"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:letterSpacing="0.05"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spnPrinters"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_spinner_field"
        android:layout_marginBottom="10dp" />

    <!-- Prefix Checkbox -->
    <CheckBox
        android:id="@+id/cbIncludePrefix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/checkbox_include_logo"
        android:textColor="#334155"
        android:textSize="13sp"
        android:textStyle="bold"
        android:checked="true"
        android:layout_marginBottom="8dp" />

    <!-- Normal PDF Okuyucuya Paslama Butonu -->
    <Button
        android:id="@+id/btnOpenExternal"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="12dp"
        android:text="@string/btn_open_external_pdf"
        android:textColor="#475569"
        android:textSize="12sp"
        android:textStyle="bold"
        android:backgroundTint="#F8FAFC"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp"
        app:cornerRadius="10dp" />

    <ProgressBar
        android:id="@+id/pbLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Butonlar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_close"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:backgroundTint="#F1F5F9"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnPrint"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.6"
            android:text="@string/btn_print_action"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            app:cornerRadius="12dp"
            android:enabled="false" />
    </LinearLayout>

</LinearLayout>